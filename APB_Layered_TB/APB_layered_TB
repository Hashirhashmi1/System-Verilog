// TRANSACTION 

class transaction;
  bit [7:0] paddr;
  bit psel;
  bit penable;
  bit pwrite;
  bit [31:0] pwdata;
  bit [31:0] prdata;
  bit pready;
  bit pslverr;
endclass

// GENERATOR 

class generator;
  mailbox #(transaction) mbx;

  function new(mailbox #(transaction) mbx);
    this.mbx = mbx;
  endfunction

  task run();
    transaction tr;

    // WRITE 04 = A5
    tr = new();
    tr.paddr = 8'h04;
    tr.psel = 1;
    tr.penable = 0;
    tr.pwrite = 1;
    tr.pwdata = 32'h000000A5;
    mbx.put(tr);
    $display("[GEN] WRITE Address=%h Data=%h",tr.paddr,tr.pwdata);

    // READ 04
    tr = new();
    tr.paddr = 8'h04;
    tr.psel = 1;
    tr.penable = 0;
    tr.pwrite = 0;
    tr.pwdata = 0;
    mbx.put(tr);
    $display("[GEN] READ Address=%h",tr.paddr);

    // WRITE 08 = 5A
    tr = new();
    tr.paddr = 8'h08;
    tr.psel = 1;
    tr.penable = 0;
    tr.pwrite = 1;
    tr.pwdata = 32'h0000005A;
    mbx.put(tr);
    $display("[GEN] WRITE Address=%h Data=%h",tr.paddr,tr.pwdata);

    // READ 08
    tr = new();
    tr.paddr = 8'h08;
    tr.psel = 1;
    tr.penable = 0;
    tr.pwrite = 0;
    tr.pwdata = 0;
    mbx.put(tr);
    $display("[GEN] READ Address=%h",tr.paddr);

    $display("[GEN] All transactions sent");
  endtask
endclass

//DRIVER

class driver;
  mailbox #(transaction) mbx;
  virtual apb_if vif;

  function new(mailbox #(transaction) mbx,virtual apb_if vif);
    this.mbx = mbx;
    this.vif = vif;
  endfunction

  task run();
    transaction tr;

    forever begin
      mbx.get(tr);
      $display("[DRV] Transaction received");

      // APB SETUP
      @(negedge vif.pclk);
      vif.psel = tr.psel;
      vif.penable = tr.penable;
      vif.pwrite = tr.pwrite;
      vif.paddr = tr.paddr;
      vif.pwdata = tr.pwdata;

      // APB ACCESS
      @(negedge vif.pclk);
      vif.penable = 1;

      while(!vif.pready)
        @(posedge vif.pclk);

      @(negedge vif.pclk);
      vif.psel = 0;
      vif.penable = 0;

      $display("[DRV] Transaction completed");
    end
  endtask
endclass

// MONITOR 

class monitor;
  mailbox #(transaction) mbx;
  virtual apb_if vif;

  function new(mailbox #(transaction) mbx,virtual apb_if vif);
    this.mbx = mbx;
    this.vif = vif;
  endfunction

  task run();
    transaction tr;

    forever begin
      @(posedge vif.pclk);

      if(vif.psel && vif.penable && vif.pready) begin
        tr = new();
        tr.paddr = vif.paddr;
        tr.psel = vif.psel;
        tr.penable = vif.penable;
        tr.pwrite = vif.pwrite;
        tr.pwdata = vif.pwdata;
        tr.prdata = vif.prdata;
        tr.pready = vif.pready;
        tr.pslverr = vif.pslverr;

        $display("[MON] Address=%h Write=%0d WData=%h RData=%h Ready=%0d Error=%0d",
                 tr.paddr,tr.pwrite,tr.pwdata,tr.prdata,tr.pready,tr.pslverr);

        mbx.put(tr);
      end
    end
  endtask
endclass

// SCOREBOARD 

class scoreboard;
  mailbox #(transaction) mbx;
  bit [31:0] expected_mem [0:255];

  function new(mailbox #(transaction) mbx);
    this.mbx = mbx;
  endfunction

  task run();
    transaction tr;

    forever begin
      mbx.get(tr);

      if(tr.pwrite) begin
        expected_mem[tr.paddr] = tr.pwdata;
        $display("[SCB] WRITE Address=%h Data=%h",
                 tr.paddr,tr.pwdata);
      end
      else begin
        $display("[SCB] READ Address=%h Expected=%h Actual=%h",
                 tr.paddr,expected_mem[tr.paddr],tr.prdata);

        if(expected_mem[tr.paddr] == tr.prdata)
          $display("[SCB] READ PASS");
        else
          $display("[SCB] READ FAIL");
      end
    end
  endtask
endclass

//TESTBENCH

module tb;
  logic pclk;

  initial begin
    pclk = 0;
    forever #5 pclk = ~pclk;
  end

  apb_if vif(pclk);
  apb_dut dut(vif);

  mailbox #(transaction) gen_mbx;
  mailbox #(transaction) mon_mbx;

  generator gen;
  driver drv;
  monitor mon;
  scoreboard scb;

  initial begin
    // VCD
    $dumpfile("dump.vcd");
    $dumpvars(0,tb);

    gen_mbx = new();
    mon_mbx = new();

    gen = new(gen_mbx);
    drv = new(gen_mbx,vif);
    mon = new(mon_mbx,vif);
    scb = new(mon_mbx);

    // RESET
    vif.presetn = 0;
    vif.psel = 0;
    vif.penable = 0;
    vif.pwrite = 0;
    vif.paddr = 0;
    vif.pwdata = 0;

    repeat(2)
      @(posedge pclk);

    vif.presetn = 1;

    $display(" RESET DONE ");

    fork
      drv.run();
      mon.run();
      scb.run();
    join_none

    gen.run();

    #150;

    $display("========== TEST DONE ==========");
    $finish;
  end
endmodule